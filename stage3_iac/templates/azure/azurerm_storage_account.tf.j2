resource "azurerm_storage_account" "{{ node_id }}" {
  name                     = "{{ config.name | lower | replace('-', '') }}"
  resource_group_name      = azurerm_resource_group.tricloudgate_rg.name
  location                 = azurerm_resource_group.tricloudgate_rg.location
  account_tier             = "{{ config.account_tier }}"
  account_replication_type = "{{ config.replication_type }}"
  tags = {
    Name    = "{{ config.name }}"
    Project = "TriCloudGate"
  }
}

output "{{ node_id }}_primary_blob_endpoint" {
  description = "Primary blob endpoint of {{ config.name }}"
  value       = azurerm_storage_account.{{ node_id }}.primary_blob_endpoint
}
