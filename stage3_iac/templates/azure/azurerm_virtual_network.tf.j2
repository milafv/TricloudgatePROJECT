resource "azurerm_virtual_network" "{{ node_id }}" {
  name                = "{{ config.name }}"
  address_space       = ["{{ config.address_space }}"]
  resource_group_name = azurerm_resource_group.tricloudgate_rg.name
  location            = azurerm_resource_group.tricloudgate_rg.location
  tags = {
    Name    = "{{ config.name }}"
    Project = "TriCloudGate"
  }
}

output "{{ node_id }}_vnet_id" {
  description = "ID of {{ config.name }}"
  value       = azurerm_virtual_network.{{ node_id }}.id
}
