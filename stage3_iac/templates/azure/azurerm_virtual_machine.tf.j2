resource "azurerm_subnet" "{{ node_id }}_subnet" {
  name                 = "{{ node_id }}-subnet"
  resource_group_name  = azurerm_resource_group.tricloudgate_rg.name
  virtual_network_name = azurerm_virtual_network.{{ network_node_id }}.name
  address_prefixes     = ["10.1.1.0/24"]
}

resource "azurerm_network_interface" "{{ node_id }}_nic" {
  name                = "{{ node_id }}-nic"
  location            = azurerm_resource_group.tricloudgate_rg.location
  resource_group_name = azurerm_resource_group.tricloudgate_rg.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.{{ node_id }}_subnet.id
    private_ip_address_allocation = "Dynamic"
  }
}


resource "azurerm_virtual_machine" "{{ node_id }}" {
  name                  = "{{ config.name }}"
  location              = azurerm_resource_group.tricloudgate_rg.location
  resource_group_name   = azurerm_resource_group.tricloudgate_rg.name
  network_interface_ids = [azurerm_network_interface.{{ node_id }}_nic.id]
  vm_size               = "{{ config.vm_size }}"

  storage_os_disk {
    name              = "{{ node_id }}-osdisk"
    caching           = "ReadWrite"
    create_option     = "FromImage"
    managed_disk_type = "Standard_LRS"
  }

  storage_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts"
    version   = "latest"
  }

  os_profile {
    computer_name  = "{{ node_id }}"
    admin_username = "{{ config.admin_username }}"
    admin_password = "TriCloudGate123!"
  }

  os_profile_linux_config {
    disable_password_authentication = false
  }

  tags = {
    Name    = "{{ config.name }}"
    Project = "TriCloudGate"
  }
}

output "{{ node_id }}_vm_id" {
  description = "ID of {{ config.name }}"
  value       = azurerm_virtual_machine.{{ node_id }}.id
}